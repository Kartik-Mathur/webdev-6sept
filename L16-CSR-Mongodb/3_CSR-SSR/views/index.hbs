<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{title}}</title>
    <link rel="stylesheet" href="style.css">
</head>

<body>
    <h1>Todo App</h1>

    <form action="/todos" method="POST">
        <input type="text" name="name">
        <button type="submit">Submit</button>
    </form>

    <div id="tasks">
        {{#if todos.length}}
            {{#each todos as |t|}}
            <li>
                {{t}}
                <a href="/delete-todo/{{t}}">Delete</a>
                <a href="/increase/{{t}}">
                    <button>⬆️</button>
                </a>
                <a href="/decrease/{{t}}">
                    <button>👇🏻</button>
                </a>
            </li>
            {{/each}}
        {{else}}
            Todos Not Available
        {{/if}}
    </div>

</body>

</html>