<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{title}}</title>
    <link rel="stylesheet" href="style.css">
</head>

<body>
    <h1>Todo App</h1>

    <button id="btn">Get Todos</button>
    <div id="tasks">
        {{#each todos as |t|}}
        <li>{{t}}</li>
        {{/each}}
    </div>

</body>

</html>