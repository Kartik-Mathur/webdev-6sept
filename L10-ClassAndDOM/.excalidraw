      "link": null,
      "locked": false,
      "text": "class Car{\n    constructor(name, model){\n        this.name = name;\n        this.model = model;\n    }\n    printCar(){\n        console.log(\"Name\",this.name)\n        console.log(\"Model\",this.model)\n    }\n};\n\nlet maruti = new Car(\"Maruti\", \"White\");\nlet bmw = new Car(\"Bmw\", \"Blue\");\n\nconsole.log(maruti);\nconsole.log(bmw);",
